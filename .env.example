# Server
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# PostgreSQL is the only runtime datasource - required, the app refuses to start without it.
# See `docker-compose.yml` for a local Postgres you can point this at, and the README's
# "Database" section for migrating/seeding it. JSON files under data/ are seed input only
# (via `npm run db:seed`), never read at request-serving time.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/find_nearest_restaurant

# Auth (JWT)
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1h

# Demo credentials used by POST /auth/token (replace with a real identity provider in production)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin-secret
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=user-secret

# Rate limiting for write endpoints (PUT /locations/:id)
WRITE_RATE_LIMIT_MAX=20
WRITE_RATE_LIMIT_WINDOW=1 minute
